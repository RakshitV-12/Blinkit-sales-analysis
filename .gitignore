# ==========================================
# Byte-compiled / optimized / DLL files
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so

# ==========================================
# Virtual Environments
# ==========================================
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
bin/
include/
lib/
lib64/
pyvenv.cfg

# ==========================================
# Jupyter Notebook
# ==========================================
.ipynb_checkpoints/
*-checkpoint.ipynb
.jupyter/

# ==========================================
# Streamlit Configuration & Secrets
# ==========================================
.streamlit/secrets.toml

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# IDEs and Code Editors
# ==========================================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ==========================================
# Operating System Files
# ==========================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# ==========================================
# Logs, Databases & Temporary Files
# ==========================================
*.log
*.sqlite3
*.tmp

# ==========================================
# Testing & Code Quality
# ==========================================
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# ==========================================
# Model Artifacts
# ==========================================
# Ignore intermediate/loose model files in notebooks root,
# while preserving the production deployment model used by app.py
notebooks/*.joblib
!notebooks/models/sales_prediction_model.joblib
